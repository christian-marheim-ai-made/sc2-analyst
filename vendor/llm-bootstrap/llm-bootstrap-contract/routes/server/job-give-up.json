{
  "id": "server.jobs.give_up",
  "method": "POST",
  "path": "/api/jobs/{id}/give-up",
  "summary": "Stronger than cancel: the queue is handed back whatever the worker is doing. A queued job ends at once. A running one is flagged and a clock starts; if it has not let go within `grace_s`, the server ends it over the worker's head and a new worker takes the queue, so the job behind it runs. The answer comes back at once - the job reads `running` until it has let go or been taken back.",
  "request": null,
  "responses": {
    "200": {"object": {"job": {"ref": "job"}, "was": {"enum": ["queued", "running", "held"]}, "grace_s": "number"}},
    "404": {"object": {"error": "string", "reason": {"enum": ["no_such_job"]}}},
    "409": {"object": {"error": "string", "reason": {"enum": ["finished", "no_workspace"]}, "status": {"enum": ["done", "failed", "cancelled", "claimed"]}}, "optional": ["status"]},
    "503": {"object": {"error": "string", "reason": {"enum": ["store_unreadable"]}}}
  },
  "examples": [
    {"name": "given up on while running: the clock is started", "status": 200, "path": "/api/jobs/j-0010/give-up", "response": {"job": {"id": "j-0010", "kind": "generate", "name": "reading 1 of 3", "status": "running", "priority": "batch", "queue_pos": 0, "after": [], "group": "fan-0003", "scope": "book-1", "correlation_id": "c-20260923-140101-c3w5r8t2", "correlation_source": "client", "client": "cli-w5r8t2h6", "claimed_by": null, "retry_of": null, "model": "demo-7b", "n": 1, "n_done": 0, "progress": {"variant": 1, "of": 1, "budget": 400, "spent": 0, "handle": "srv-k3x9m2p7:j-0010#01", "at": 1790172098.5, "reported": true, "stage": "writing", "tokens": 120, "tok_s": 38.5}, "created": 1790172061.0, "finished": null, "stalled_for": 340.0, "error": null}, "was": "running", "grace_s": 10.0}},
    {"name": "given up on before it started", "status": 200, "path": "/api/jobs/j-0008/give-up", "response": {"job": {"id": "j-0008", "kind": "generate", "name": "part 2", "status": "cancelled", "priority": "batch", "queue_pos": 0, "after": ["j-0007"], "group": null, "scope": "book-1", "correlation_id": "c-20260923-140040-b2x7q4n8", "correlation_source": "client", "client": "cli-w5r8t2h6", "claimed_by": null, "retry_of": null, "model": "demo-7b", "n": 1, "n_done": 0, "progress": {}, "created": 1790172040.0, "finished": 1790172045.0, "stalled_for": null, "error": null}, "was": "queued", "grace_s": 10.0}},
    {"name": "already finished", "status": 409, "path": "/api/jobs/j-0007/give-up", "response": {"error": "j-0007 is done: there is nothing to give up", "reason": "finished", "status": "done"}},
    {"name": "nothing bound", "status": 409, "path": "/api/jobs/j-0010/give-up", "response": {"error": "no folder is bound: choose one first", "reason": "no_workspace"}},
    {"name": "no such job", "status": 404, "path": "/api/jobs/j-9999/give-up", "response": {"error": "no such job: j-9999", "reason": "no_such_job"}},
