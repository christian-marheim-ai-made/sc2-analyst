{
  "id": "server.jobs.cancel",
  "method": "POST",
  "path": "/api/jobs/{id}/cancel",
  "summary": "Stop a job that has not finished. `was` says whether it had started, because cancelling a running job also ends a generation and gives the card back. A held job (PLAN-4 D16) ends at once, `was: held`: nothing is on the card for it. A running job whose generation has not let go yet is answered still `running`; it ends `cancelled` when it does, and a cancel asked for before the server stopped still stands after it restarts.",
  "request": null,
  "responses": {
    "200": {"object": {"job": {"ref": "job"}, "was": {"enum": ["queued", "running", "held"]}}},
    "404": {"object": {"error": "string", "reason": {"enum": ["no_such_job"]}}},
    "409": {"object": {"error": "string", "reason": {"enum": ["finished", "no_workspace"]}, "status": {"enum": ["done", "failed", "cancelled", "claimed"]}}, "optional": ["status"]},
    "503": {"object": {"error": "string", "reason": {"enum": ["store_unreadable"]}}}
  },
